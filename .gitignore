# Benchmark data is NEVER committed. It is reconstructed locally from the
# scripts, which ARE committed:
#     bash scripts/rebuild_data.sh          # fetch + prepare everything
# data/manifest.json is deliberately NOT ignored: it records each source's URL,
# license and sha256, so a rebuild can be verified rather than merely assumed.
# gitignore does NOT support trailing comments -- a pattern with one appended
# matches nothing. Keep every comment on its own line.
# as-downloaded benchmark archives
data/raw/
data/cache/
# documents derived from the corpus half (still the publishers' content)
data/corpus/
# chunk-baseline index built from those documents
data/chunks/
# anything derived from the questions half
data/gold/
# writing briefs inline the corpus text, so they are the publishers' content
# rather than our notes; regenerate with scripts/emit_write_brief.py
experiments/plans/*/briefs/
*.jsonl.gz
*.zip

# Local experiment outputs
experiments/runs/
figures/
__pycache__/
*.pyc
.DS_Store

# Local, organisation-specific scrub patterns (never published)
.scrub-patterns

# Per-vault databases are rebuilt from the notes by scripts/build_local_db.py
vaults/*/notes.db
vaults/*/notes.db-wal
vaults/*/notes.db-shm

# rebuildable dense index
**/embeddings.npy
**/embedding_ids.json
**/notes.db
**/notes.db-wal
**/notes.db-shm
experiments/output/*
!experiments/output/README.md

# v1 baseline working copy — reproducible from the vault-v1-baseline tag
vaults/v1_baseline/
